        {
          "name": "Create User (Tích hợp Data-Driven Testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra Status code trả về là 201 (Created)\npm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\n// 2. Kiểm tra trường name và job khớp với dữ liệu từ file CSV\npm.test(\"Validate name and job from CSV\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.name).to.eql(pm.iterationData.get(\"name\"));\n    pm.expect(jsonData.job).to.eql(pm.iterationData.get(\"job\"));\n});\n\n// 3. Trích xuất id trả về và gán vào biến môi trường userId\nvar jsonData = pm.response.json();\npm.environment.set(\"userId\", jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "free_user_3L2mLqy68hsggHQmWwqmpvooevW"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{name}}\",\n    \"job\": \"{{job}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
